# Copy to .env and fill in real values — never commit .env to git

# Server
ENV=production
PORT=1234
BASE_ADDRESS=0.0.0.0

# Database — used by both MariaDB container and the app
DB_HOST=db
DB_PORT=3306
DB_NAME=housely
DB_USER=housely_user
DB_PASSWORD=change-me-strong-password
DB_ROOT_PASSWORD=change-me-root-password

# JWT — generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1h

# Bcrypt
BCRYPT_SALT_ROUNDS=10

# Default admin (created on first startup if no admin exists)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-me-admin-password
